# MailSentra Environment Configuration (Development Template)

PROJECT_NAME="MailSentra Threat Detection Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Security & Cryptography (Generate a 64-char random string in production)
SECRET_KEY="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Ingestion Collector Access Control
# Set to 'true' to require API key or JWT authentication for all email ingestion
# (Automatically enforced when ENVIRONMENT is not 'development')
REQUIRE_INGESTION_AUTH=false
# High-entropy API key for automated mail collectors/MTAs (e.g., ms_live_...)
# Generate using: python -c "import secrets; print('ms_live_' + secrets.token_urlsafe(32))"
INGESTION_API_KEY=""
INGESTION_API_KEY_HEADER="X-API-Key"

# Database Connection (Async SQLite for local dev, PostgreSQL for production)
DATABASE_URL="sqlite+aiosqlite:///./mailsentra.db"

# Cross-Origin Resource Sharing (CORS)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Threat Engine Defaults
MAX_EMAIL_SIZE_BYTES=15728640
DEFAULT_RISK_THRESHOLD_SUSPICIOUS=30
DEFAULT_RISK_THRESHOLD_MALICIOUS=70
