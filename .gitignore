# ==============================================================================
# MailSentra Threat Detection Platform - Git Ignore Rules
# ==============================================================================

# Python Bytecode & Runtime Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
ENV/
env/

# Packaging & Distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage Caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage/
htmlcov/
.cache

# Environment Configurations & Secret Keys
.env
.env.*
*.env
# Ensure environment example templates are explicitly tracked
!.env.example

# Local Databases & Persistent Storage
*.db
*.sqlite
*.sqlite3
mailsentra.db
backend/mailsentra.db
data/*.db

# Node.js & Frontend Build Outputs
node_modules/
*/node_modules/
frontend/dist/
frontend/build/
.npm

# Logs & Temporary Process Identifiers
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.pid

# Certificates, Keys & Credentials
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der

# Editor & OS Metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Scratch & Temporary Directories
tmp/
temp/
*.tmp
scratch/

# Raw external dataset archives (never commit raw external email/binary files to git)
*.mbox
*.eml
*.tar.gz
*.tgz
*.bz2
*.zip
backend/data/raw/downloads/
backend/data/raw/phishing_email/nazario/
backend/data/raw/spam_email/spamassassin/
backend/data/raw/sender_spoofing/epvme/
backend/data/raw/**/*.mbox
backend/data/raw/**/*.eml
backend/data/raw/**/*.tar.gz
backend/data/raw/**/*.tgz
backend/data/raw/**/*.bz2
backend/data/raw/**/*.zip

# Processed external dataset records (never commit parsed message records to git)
*.jsonl
backend/data/processed/
backend/data/processed/**


